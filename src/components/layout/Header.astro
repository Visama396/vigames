---
const pathname = Astro.url.pathname;

const links = [
  { href: "/", label: "Inicio" },
  { href: "/games", label: "Catálogo" },
  { href: "/leaderboard", label: "Clasificación" },
];

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<header
  class="sticky top-0 z-40 border-b border-white/10 bg-surface/85 backdrop-blur"
>
  <div
    class="mx-auto flex w-full max-w-6xl items-center gap-4 px-4 py-3 sm:px-6"
  >
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 rounded-lg text-lg font-bold tracking-tight"
      aria-label="Visagames, inicio"
    >
      <span
        class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br from-brand-400 to-fuchsia-500 text-base font-black text-white shadow-lg shadow-brand-500/30"
      >
        V
      </span>
      <span>Visagames</span>
    </a>

    <nav aria-label="Navegación principal" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[
                  "rounded-lg px-3 py-2 text-sm font-medium transition-colors",
                  isActive(link.href)
                    ? "bg-white/10 text-white"
                    : "text-slate-300 hover:bg-white/5 hover:text-white",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a
        href="/login"
        class="hidden rounded-lg px-3 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-white/5 hover:text-white sm:block"
      >
        Iniciar sesión
      </a>
      <a
        href="/register"
        class="rounded-lg bg-brand-500 px-3 py-2 text-sm font-semibold text-white shadow-lg shadow-brand-500/25 transition-colors hover:bg-brand-400"
      >
        Crear cuenta
      </a>
    </div>
  </div>

  <nav
    aria-label="Navegación principal móvil"
    class="border-t border-white/10 px-4 pb-2 md:hidden"
  >
    <ul class="flex items-center gap-1 overflow-x-auto">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "block whitespace-nowrap rounded-lg px-3 py-2 text-sm font-medium transition-colors",
                isActive(link.href)
                  ? "bg-white/10 text-white"
                  : "text-slate-300 hover:bg-white/5 hover:text-white",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
