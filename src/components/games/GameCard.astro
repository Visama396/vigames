---
interface Game {
  slug: string;
  title: string;
  description: string;
  category: string[];
  engine: string;
  thumbnail?: string;
  featured?: boolean;
  supportsScores?: boolean;
  comingSoon?: boolean;
}

interface Props {
  game: Game;
}

const { game } = Astro.props;
---

<article class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] transition-all hover:-translate-y-0.5 hover:border-brand-400/50 hover:bg-white/[0.06] hover:shadow-lg hover:shadow-brand-500/10">
  <a href={game.comingSoon ? "#" : `/games/${game.slug}`} class="block">
    <div class="relative aspect-video w-full overflow-hidden bg-gradient-to-br from-slate-800 to-slate-900">
      {game.thumbnail ? (
        <img
          src={game.thumbnail}
          alt={game.title}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-4xl">
          🎮
        </div>
      )}
      {game.comingSoon && (
        <div class="absolute inset-0 flex items-center justify-center bg-slate-950/70">
          <span class="rounded-full border border-amber-400/50 bg-amber-400/10 px-3 py-1 text-xs font-semibold text-amber-200">
            Próximamente
          </span>
        </div>
      )}
    </div>
    <div class="p-4">
      <div class="flex items-start justify-between gap-2">
        <h3 class="text-base font-semibold text-white">{game.title}</h3>
        <span class="rounded-full border border-white/10 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider text-slate-400">
          {game.engine}
        </span>
      </div>
      <p class="mt-1.5 line-clamp-2 text-sm text-slate-400">{game.description}</p>
      <div class="mt-3 flex flex-wrap items-center gap-1.5">
        {game.category.map((cat) => (
          <span class="rounded-full bg-white/5 px-2 py-0.5 text-[10px] font-medium text-slate-300">
            {cat}
          </span>
        ))}
      </div>
    </div>
  </a>
</article>
