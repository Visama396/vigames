---
import Layout from "../../layouts/Layout.astro";
import Leaderboard from "../../components/leaderboard/Leaderboard";
---

<Layout
  title="Clasificación"
  description="Consulta las clasificaciones globales de Visagames y compite con tus mejores progresos."
>
  <section class="mx-auto max-w-6xl px-4 pb-4 pt-10 sm:px-6 sm:pt-14">
    <p class="text-xs font-semibold uppercase tracking-widest text-brand-400">
      Clasificación
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
      Clasificaciones globales
    </h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-400 sm:text-base">
      Los mejores progresos de cada juego, guardados en tu cuenta y visibles
      para toda la comunidad. Juega con sesión iniciada para entrar en la
      clasificación.
    </p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a
        href="/games"
        class="rounded-xl bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white shadow-lg shadow-brand-500/25 transition-colors hover:bg-brand-400"
      >
        Explorar catálogo
      </a>
      <a
        href="/login"
        class="rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm font-semibold text-slate-200 transition-colors hover:bg-white/10 hover:text-white"
      >
        Iniciar sesión
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-12 sm:px-6">
    <Leaderboard client:load />
  </section>
</Layout>
